# PawPass — ejemplo ficticio (no usar valores reales)
DATABASE_URL=postgresql://user:password@host/pawpass?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/pawpass?sslmode=require
BROKEN_DATABASE_URL=postgresql://user:invalid@host/pawpass?sslmode=require
DEMO_LAB_ENABLED=true
DEMO_CONTROL_TOKEN=local-token
SLOW_REQUEST_THRESHOLD_MS=2000
